#!/usr/bin/env python3
"""Decrypt SOPS .enc.env files on the workstation and push .env to a node."""

import argparse
import base64
import os
import re
import shlex
import subprocess
import sys
from pathlib import Path

REMOTE_SCRIPT = r"""set -eu
umask 077

IFS= read -r dest
mkdir -p "$dest"
while IFS= read -r project && IFS= read -r b64_content; do
    case "$project" in
        ""|*/*|*..*) echo "Invalid project name" >&2; exit 1 ;;
    esac
    dir="$dest/compositions/$project"
    mkdir -p "$dir"
    tmp="$(mktemp "$dir/.env.XXXXXX")"
    trap 'rm -f "$tmp"' EXIT
    printf '%s' "$b64_content" | base64 -d > "$tmp"
    chmod 600 "$tmp"
    mv "$tmp" "$dir/.env"
    trap - EXIT
    if [ -e "$dir/.enc.env" ]; then
        touch "$dir/.enc.env"
    fi
done
"""


def push_secrets(args):
    repo = args.repo.resolve()
    node_name = args.node_name if args.node_name is not None else repo.name
    if not re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9._-]*", node_name):
        raise ValueError("invalid node name")
    sops_env = dict(os.environ)
    if "SOPS_AGE_KEY_FILE" not in sops_env:
        candidate_key = Path.home() / ".config/sops/age" / node_name / "keys.txt"
        if candidate_key.is_file():
            sops_env["SOPS_AGE_KEY_FILE"] = str(candidate_key)
    comp_dir = repo / "compositions"
    if args.project:
        files = [comp_dir / args.project / ".enc.env"]
    else:
        files = sorted(comp_dir.glob("*/.enc.env"))
    if not files or not any(f.is_file() for f in files):
        raise ValueError("no .enc.env files found")
    lines = [f"/srv/{node_name}"]
    for enc in files:
        if not enc.is_file():
            raise ValueError(f"missing {enc}")
        decrypted = subprocess.run(
            ["sops", "-d", "--input-type", "dotenv", "--output-type", "dotenv", str(enc)],
            capture_output=True, text=True, check=True, env=sops_env,
        ).stdout
        lines.append(enc.parent.name)
        lines.append(base64.b64encode(decrypted.encode()).decode("ascii"))
    payload = "\n".join(lines) + "\n"
    remote = "exec sh -c " + shlex.quote(REMOTE_SCRIPT)
    result = subprocess.run(
        ["ssh", "-T", "-a", "-S", "none", "-o", "StrictHostKeyChecking=yes",
         "-o", "ClearAllForwardings=yes", "--", args.target, remote],
        input=payload.encode(),
    )
    if result.returncode == 0:
        print(f"Pushed {len(files)} .env file(s) to {args.target}:/srv/{node_name}.")
    return result.returncode


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--target", required=True, help="trusted SSH target (e.g. adam@node)")
    parser.add_argument("--repo", type=Path, default=Path("."), help="local node repository path")
    parser.add_argument("--node-name", help="remote directory name under /srv (defaults to repo dir name)")
    parser.add_argument("--project", help="push .env for a single composition only")
    args = parser.parse_args()
    try:
        return push_secrets(args)
    except (OSError, ValueError, subprocess.CalledProcessError) as exc:
        parser.exit(1, f"secrets: {exc}\n")


if __name__ == "__main__":
    sys.exit(main())
