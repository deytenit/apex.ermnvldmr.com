#!/usr/bin/env python3
"""Decrypt SOPS .enc.env and @tier0/*.enc* files on the workstation and push to a node."""

import argparse
import base64
import os
import re
import shlex
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from engine.lib import tier0  # noqa: E402

REMOTE_SCRIPT = r"""set -eu
umask 077

IFS= read -r dest
mkdir -p "$dest"
while IFS= read -r target_rel && IFS= read -r b64_content; do
    case "$target_rel" in
        ""|/*|*..*|*//*) echo "Invalid target path: $target_rel" >&2; exit 1 ;;
        */*)
            proj="${target_rel%%/*}"
            rest="${target_rel#*/}"
            case "$rest" in
                @tier0/*) ;;
                *) echo "Invalid composition subpath: $target_rel" >&2; exit 1 ;;
            esac
            out="$dest/compositions/$proj/$rest"
            enc_dir="$(dirname "$out")"
            mkdir -p "$enc_dir"
            base="$(basename "$out")"
            tmp="$(mktemp "$enc_dir/.${base}.XXXXXX")"
            trap 'rm -f "$tmp"' EXIT
            printf '%s' "$b64_content" | base64 -d > "$tmp"
            case "$base" in
                .gitignore) chmod 644 "$tmp" ;;
                *.key|*.private|*.secret) chmod 600 "$tmp" ;;
                *) chmod 640 "$tmp" ;;
            esac
            mv "$tmp" "$out"
            trap - EXIT
            ;;
        *)
            dir="$dest/compositions/$target_rel"
            mkdir -p "$dir"
            tmp="$(mktemp "$dir/.env.XXXXXX")"
            trap 'rm -f "$tmp"' EXIT
            printf '%s' "$b64_content" | base64 -d > "$tmp"
            chmod 600 "$tmp"
            mv "$tmp" "$dir/.env"
            trap - EXIT
            if [ -e "$dir/.enc.env" ]; then
                touch "$dir/.enc.env"
            fi
            ;;
    esac
done
"""


def _collect_tier0_enc_files(comp_dir: Path, project: str | None) -> list[tuple[str, Path, Path]]:
    """Return (project_name, enc_path, plain_rel_under_project) for @tier0 encrypted files."""
    items: list[tuple[str, Path, Path]] = []
    projects = [comp_dir / project] if project else sorted(comp_dir.iterdir())
    for proj_dir in projects:
        if not proj_dir.is_dir() or proj_dir.name.startswith(".") or proj_dir.name.startswith("@"):
            continue
        t0 = proj_dir / "@tier0"
        if not t0.is_dir():
            continue
        for root, dirs, files in os.walk(t0):
            dirs.sort()
            for fname in sorted(files):
                fpath = Path(root) / fname
                if tier0.is_enc_path(fpath):
                    plain = tier0.enc_to_plain(fpath)
                    items.append((proj_dir.name, fpath, plain.relative_to(proj_dir)))
    return items


def push_secrets(args):
    repo = args.repo.resolve()
    node_name = args.node_name if args.node_name is not None else repo.name
    if not re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9._-]*", node_name):
        raise ValueError("invalid node name")
    sops_env = dict(os.environ)
    if "SOPS_AGE_KEY_FILE" not in sops_env:
        candidate_key = Path.home() / ".config/sops/age" / node_name / "keys.txt"
        if candidate_key.is_file():
            sops_env["SOPS_AGE_KEY_FILE"] = str(candidate_key)
    comp_dir = repo / "compositions"
    if args.project:
        env_files = [comp_dir / args.project / ".enc.env"]
    else:
        env_files = sorted(comp_dir.glob("*/.enc.env"))
    tier0_items = _collect_tier0_enc_files(comp_dir, args.project)
    if (not env_files or not any(f.is_file() for f in env_files)) and not tier0_items:
        raise ValueError("no .enc.env or @tier0 encrypted files found")
    lines = [f"/srv/{node_name}"]
    env_count = 0
    for enc in env_files:
        if not enc.is_file():
            if args.project and not tier0_items:
                raise ValueError(f"missing {enc}")
            continue
        decrypted = subprocess.run(
            ["sops", "-d", "--input-type", "dotenv", "--output-type", "dotenv", str(enc)],
            capture_output=True, text=True, check=True, env=sops_env,
        ).stdout
        lines.append(enc.parent.name)
        lines.append(base64.b64encode(decrypted.encode("utf-8")).decode("ascii"))
        env_count += 1

    tier0_by_proj: dict[str, list[str]] = {}
    for proj_name, enc_path, plain_rel in tier0_items:
        in_t, out_t = tier0.sops_io_types(plain_rel, enc_path, decrypt=True)
        decrypted_bytes = subprocess.run(
            ["sops", "-d", "--input-type", in_t, "--output-type", out_t, str(enc_path)],
            capture_output=True, check=True, env=sops_env,
        ).stdout
        rel_posix = plain_rel.as_posix()
        lines.append(f"{proj_name}/{rel_posix}")
        lines.append(base64.b64encode(decrypted_bytes).decode("ascii"))
        t0_sub = plain_rel.relative_to("@tier0").as_posix()
        tier0_by_proj.setdefault(proj_name, []).append(f"/{t0_sub}")

    for proj_name, ignored_list in sorted(tier0_by_proj.items()):
        gi_body = tier0.GITIGNORE_HEADER + "".join(f"{e}\n" for e in sorted(set(ignored_list)))
        lines.append(f"{proj_name}/@tier0/.gitignore")
        lines.append(base64.b64encode(gi_body.encode("utf-8")).decode("ascii"))

    payload = "\n".join(lines) + "\n"
    remote = "exec sh -c " + shlex.quote(REMOTE_SCRIPT)
    result = subprocess.run(
        ["ssh", "-T", "-a", "-S", "none", "-o", "StrictHostKeyChecking=yes",
         "-o", "ClearAllForwardings=yes", "--", args.target, remote],
        input=payload.encode("utf-8"),
    )
    if result.returncode == 0:
        print(
            f"Pushed {env_count} .env file(s) and {len(tier0_items)} @tier0 secret file(s) "
            f"to {args.target}:/srv/{node_name}."
        )
    return result.returncode


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--target", required=True, help="trusted SSH target (e.g. adam@node)")
    parser.add_argument("--repo", type=Path, default=Path("."), help="local node repository path")
    parser.add_argument("--node-name", help="remote directory name under /srv (defaults to repo dir name)")
    parser.add_argument("--project", help="push secrets for a single composition only")
    args = parser.parse_args()
    try:
        return push_secrets(args)
    except (OSError, ValueError, subprocess.CalledProcessError) as exc:
        parser.exit(1, f"secrets: {exc}\n")


if __name__ == "__main__":
    sys.exit(main())
