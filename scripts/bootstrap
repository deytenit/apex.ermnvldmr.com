#!/usr/bin/env python3
"""Bootstrap a fleet node through a trusted OpenSSH connection."""

import argparse
import base64
import re
import shlex
import subprocess
import sys
from pathlib import Path
from urllib.parse import urlsplit

REMOTE_SCRIPT = r"""set -eu
umask 077

if ! command -v git >/dev/null 2>&1 || ! command -v ssh >/dev/null 2>&1; then
    echo "git and openssh-client are required on the target host" >&2
    exit 1
fi

IFS= read -r node_name
IFS= read -r repo_url
IFS= read -r git_host
IFS= read -r b64_operator
IFS= read -r b64_deploy
IFS= read -r b64_hosts

if ! id -u adam >/dev/null 2>&1; then
    useradd --create-home --user-group --shell /bin/bash adam
fi
uid="$(id -u adam)"
gid="$(id -g adam)"
[ "$uid" -ge 1000 ] || { echo "Existing adam account must have uid >= 1000" >&2; exit 1; }
home="/home/adam"
[ -d "$home" ] || { echo "Missing /home/adam" >&2; exit 1; }

ssh_dir="$home/.ssh"
mkdir -p "$ssh_dir"
chmod 700 "$ssh_dir"
chown "$uid:$gid" "$ssh_dir"

operator_key="$(printf '%s' "$b64_operator" | base64 -d)"
auth_keys="$ssh_dir/authorized_keys"
touch "$auth_keys"
if ! grep -Fqx "$operator_key" "$auth_keys"; then
    printf '%s\n' "$operator_key" >> "$auth_keys"
fi
chmod 600 "$auth_keys"
chown "$uid:$gid" "$auth_keys"

prefix="$ssh_dir/apex-$node_name"
printf '%s' "$b64_deploy" | base64 -d > "$prefix.key"
printf '%s' "$b64_hosts" | base64 -d > "$prefix.hosts"
cat > "$prefix.sshconf" <<EOF
Host $git_host
    IdentitiesOnly yes
    IdentityFile $prefix.key
    UserKnownHostsFile $prefix.hosts
    GlobalKnownHostsFile /dev/null
Host *
    StrictHostKeyChecking yes
    BatchMode yes
EOF
printf '[core]\n\tsshCommand = ssh -F %s.sshconf\n' "$prefix" > "$prefix.gitconf"
chmod 600 "$prefix.key" "$prefix.hosts" "$prefix.sshconf" "$prefix.gitconf"
chown "$uid:$gid" "$prefix.key" "$prefix.hosts" "$prefix.sshconf" "$prefix.gitconf"

gitconfig="$home/.gitconfig"
touch "$gitconfig"
if ! grep -Fq "gitdir:/srv/$node_name/.git" "$gitconfig"; then
    printf '\n[includeIf "gitdir:/srv/%s/.git"]\n\tpath = %s.gitconf\n[includeIf "gitdir:/srv/%s/.git/"]\n\tpath = %s.gitconf\n' \
        "$node_name" "$prefix" "$node_name" "$prefix" >> "$gitconfig"
fi
chmod 600 "$gitconfig"
chown "$uid:$gid" "$gitconfig"

mkdir -p /srv
chmod 755 /srv
dest="/srv/$node_name"
if [ -e "$dest" ]; then
    existing_url="$(runuser -u adam -- git -C "$dest" config --get remote.origin.url || true)"
    [ "$existing_url" = "$repo_url" ] || { echo "Existing $dest does not match $repo_url" >&2; exit 1; }
else
    mkdir -p "$dest"
    chown "$uid:$gid" "$dest"
    runuser -u adam -- env GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="ssh -F $prefix.sshconf" \
        git clone --recurse-submodules -- "$repo_url" "$dest"
fi
"""


def repository(url):
    if any(ch.isspace() or ord(ch) < 32 for ch in url):
        raise ValueError("invalid repository URL")
    if url.startswith("ssh://"):
        parts = urlsplit(url)
        if parts.password is not None or parts.query or parts.fragment:
            raise ValueError("expected an SSH repository URL without password, query or fragment")
        host, port, path = parts.hostname, parts.port, parts.path
    else:
        match = re.fullmatch(r"(?:[\w.-]+@)?(\[[\da-fA-F:]+\]|[\w.-]+):(.+)", url)
        if not match:
            raise ValueError("expected git@host:path or ssh://user@host[:port]/path")
        host, path = match.groups()
        host, port = host.strip("[]"), None
    if not host or not re.fullmatch(r"[a-zA-Z0-9:][a-zA-Z0-9.:-]*", host) or not path:
        raise ValueError("invalid Git host or repository path")
    endpoint = f"[{host}]:{port}" if port not in (None, 22) else host
    return host, endpoint, Path(path).name.removesuffix(".git")


def keygen(args, data=None):
    return subprocess.run(["ssh-keygen", *args], input=data or b"", capture_output=True)


def b64(text):
    return base64.b64encode(text.encode()).decode("ascii")


def bootstrap(args):
    host, endpoint, basename = repository(args.repo)
    name = args.node_name if args.node_name is not None else basename
    if not re.fullmatch(r"[a-zA-Z0-9][a-zA-Z0-9._-]*", name):
        raise ValueError("invalid node name")
    operator = args.operator_key.read_text().strip()
    fields = operator.split()
    if (len(operator.splitlines()) != 1 or len(fields) < 2
            or keygen(["-lf", "-"], (" ".join(fields[:2]) + "\n").encode()).returncode):
        raise ValueError("operator key must contain one plain SSH public key")
    derived = keygen(["-y", "-P", "", "-f", str(args.deploy_key.resolve())])
    if derived.returncode or derived.stdout.split()[0].startswith(b"sk-"):
        raise ValueError("deploy key must be a standalone private key with no passphrase and owner-only permissions")
    if derived.stdout.split()[:2] == [v.encode() for v in fields[:2]]:
        raise ValueError("operator and deploy keys must be different")
    matches = keygen(["-F", endpoint, "-f", str(args.known_hosts.resolve())])
    pins = [line for line in matches.stdout.decode().splitlines() if line and not line.startswith("#")]
    if matches.returncode or not pins or not any(
        not pin.startswith("@revoked ") and keygen(["-lf", "-"], (pin + "\n").encode()).returncode == 0
        for pin in pins
    ):
        raise ValueError(f"no usable known_hosts pin for {endpoint}")
    payload = "\n".join([
        name,
        args.repo,
        host,
        b64(operator),
        b64(args.deploy_key.read_text().rstrip() + "\n"),
        b64("\n".join(pins) + "\n"),
    ]) + "\n"
    remote = 'if [ "$(id -u)" -eq 0 ]; then exec sh -c ' + shlex.quote(REMOTE_SCRIPT) + '; else exec sudo -n sh -c ' + shlex.quote(REMOTE_SCRIPT) + '; fi'
    result = subprocess.run(["ssh", "-T", "-a", "-S", "none", "-o", "StrictHostKeyChecking=yes",
                           "-o", "ClearAllForwardings=yes", "--", args.target, remote],
                          input=payload.encode())
    if result.returncode == 0:
        print(f"Checkout ready for adam at /srv/{name}.")
    return result.returncode


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--target", required=True, help="trusted SSH target with root or noninteractive sudo")
    parser.add_argument("--repo", required=True, help="SSH URL of the node repository")
    parser.add_argument("--operator-key", required=True, type=Path, help="operator public key")
    parser.add_argument("--deploy-key", required=True, type=Path, help="repository deploy private key")
    parser.add_argument("--known-hosts", required=True, type=Path, help="trusted Git server host keys")
    parser.add_argument("--node-name", help="defaults to repository basename without .git")
    args = parser.parse_args()
    try:
        return bootstrap(args)
    except (OSError, ValueError) as exc:
        parser.exit(1, f"bootstrap: {exc}\n")


if __name__ == "__main__":
    sys.exit(main())
